{
  "extends": "./tsconfig.shared.json", // Extend shared configuration
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true, // Allow default

    "types": [
      "@testing-library/jest-dom",
      "vite/client",
      "vite-plugin-svgr/client",
      "@vitest/browser/matchers"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "vitest.config.ts"
  ] // Include test files
}
